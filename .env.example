# Frontend environment variables (Vite / Vercel)
# Copy to .env.local for local dev; set in Vercel Project Settings for production.

# Backend URL — set to your Render service URL in production
VITE_API_URL=https://revenuemd-api.onrender.com

# Auth0 SPA Application (Applications → your app → Settings)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here

# Auth0 API identifier (Applications → APIs → your API → identifier)
VITE_AUTH0_AUDIENCE=https://api.revenuemd.com
