# RevenueMD Frontend — environment variables
# Copy to .env.local and fill in values
# NEVER commit .env.local to git

# Backend API URL
# Development: http://localhost:8000
# Production:  https://api.revenuemdpr.com
VITE_API_URL=http://localhost:8000

# Auth0 — leave blank to run in demo mode (any credentials work)
# Create a "Single Page Application" at https://manage.auth0.com
# Allowed Callback URLs and Allowed Web Origins: http://localhost:5173
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
