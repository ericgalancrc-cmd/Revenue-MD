# Local development environment — never commit this file.
# Start the backend first: cd backend && uvicorn main:app --reload --port 8000
VITE_API_URL=http://localhost:8000

# Auth0 — paste values from your Auth0 SPA Application settings
# Leave blank to run in demo mode (no real login required)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
