# Local development environment — never commit this file.
# Start the backend first: cd backend && uvicorn main:app --reload --port 8000
VITE_API_URL=http://localhost:8000

# Auth0 — set these in Vercel environment variables for production
# Leave blank here to run in demo mode locally
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE and VITE_AUTH0_REDIRECT_URI are set in Vercel for production
