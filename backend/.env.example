# Anthropic API key — required for document extraction (PDF / image uploads)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Allowed CORS origins (comma-separated, no spaces)
# In production: https://revenuemdpr.com,https://www.revenuemdpr.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional API key — if set, all requests must include:
#   X-API-Key: <value>
# Generate with: openssl rand -hex 32
API_KEY=

# Database URL — defaults to local SQLite for development
# In production use PostgreSQL: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./revenuemd.db

# Environment tag shown in /health
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
