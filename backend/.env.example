# Copy to .env and fill in values
# Set these in Render → your service → Environment for production.

# PostgreSQL connection string (provided automatically by Render's DB add-on)
DATABASE_URL=postgresql://user:pass@host:5432/revenuemd

# Comma-separated origins the browser is allowed to call from
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Auth0 tenant domain (from Auth0 Dashboard → Applications → your app → Settings)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Auth0 API identifier (Applications → APIs → your API → identifier)
AUTH0_AUDIENCE=https://api.revenuemd.com

# Anthropic API key — enables Claude AI enhancement on /api/analyze and
# powers /api/smart-entry (vision-based medical record + claim lines intake).
# Get yours at https://console.anthropic.com
# If omitted, /api/analyze falls back to rules-engine only, and
# /api/smart-entry returns 503 (no OCR/vision fallback exists — reading the
# uploaded images requires the AI call).
ANTHROPIC_API_KEY=sk-ant-...
